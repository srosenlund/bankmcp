{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/internal/run-watches",
      "schedule": "0 6 * * *"
    }
  ],
  "services": {
    "web": {
      "root": ".",
      "runtime": "node",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
